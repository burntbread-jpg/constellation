{
  "name": "taste-constellation-archive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "audit:dependencies": "pnpm audit --audit-level high",
    "check": "npm run build && npm test",
    "eval:recommendations": "node scripts/evaluate-recommendations.mjs --write",
    "perf:baseline": "node scripts/performance-baseline.mjs",
    "perf:baseline:write": "node scripts/performance-baseline.mjs --write",
    "backup:export": "node scripts/export-supabase-backup.mjs",
    "dr:verify": "node scripts/verify-recovery-readiness.mjs",
    "dr:verify:write": "node scripts/verify-recovery-readiness.mjs --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1"
  }
}
