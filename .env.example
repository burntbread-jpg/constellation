# Optional providers. Open Library and AniList work without keys.
TMDB_READ_TOKEN=
GOOGLE_BOOKS_API_KEY=
SUPABASE_URL=
# Public browser key (sb_publishable_...). Safe to expose; never substitute the service role key.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Reviewer allowlist used by the protected operations dashboard.
METADATA_REVIEWER_IDS=
METADATA_REVIEWER_EMAILS=
# Random secret shared only by Vercel and Supabase Vault/Cron.
HEALTH_MONITOR_TOKEN=
# Optional Slack/Discord-compatible webhook. Alerts are sent only on transitions or sustained warnings.
HEALTH_ALERT_WEBHOOK_URL=
# Optional Cloudflare Workers AI/OpenAI-compatible editorial assistant.
LOCAL_AI_ENABLED=false
LOCAL_AI_ZERO_COST_ACK=false
LOCAL_AI_CHAT_ENDPOINT=
LOCAL_AI_BEARER_TOKEN=
LOCAL_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
LOCAL_AI_DAILY_LIMIT=50
LOCAL_AI_HOURLY_PER_USER_LIMIT=10
